# Idle session length in seconds (default 1800 = 30 minutes)
QF_SESSION_IDLE_SECONDS=1800
# Timeout warning lead time in seconds (default 120 = 2 minutes)
QF_SESSION_WARNING_SECONDS=120
# Cookie domain shared with the direct site so consent is not asked twice, e.g. .example.co.uk
NEXT_PUBLIC_CONSENT_DOMAIN=
